)
ire_expat_change <- ire_expat %>%
mutate(change = `2019` - `2017`) %>%
arrange(change) %>%
mutate(Category = factor(Category, levels = Category))
ire_expat_long <- ire_expat_change %>%
pivot_longer(
cols = c(`2017`,`2018`,`2019`),
names_to = "Year",
values_to = "Rank"
)
exit 0
